# ──────────────────────────────────────────────────────────────────────────
# BalanceBook Backend — PRODUCTION environment template
# Copy to .env.production, fill in real values, NEVER commit to git.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
TRUST_PROXY=true

# ── MongoDB ───────────────────────────────────────────────────────────────
# When using docker-compose.prod.yml the host is "mongodb" (service name).
# For MongoDB Atlas replace the entire URI.
MONGODB_URI=mongodb://mongodb:27017/balancebook?replicaSet=rs0
MONGODB_DB_NAME=balancebook
USE_TRANSACTIONS=true

# ── Auth — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=true
# Set to your domain e.g. balancebook.app
COOKIE_DOMAIN=

# ── CORS / Frontend URL ───────────────────────────────────────────────────
# Set to your deployed frontend URL (no trailing slash)
CLIENT_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# ── File Uploads ──────────────────────────────────────────────────────────
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_URL=https://yourdomain.com
MAX_UPLOAD_BYTES=8388608

# Optional Cloudinary (better for production):
# UPLOAD_DRIVER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Email — Brevo (Sendinblue) ────────────────────────────────────────────
# Get your API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=REPLACE_WITH_YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=REPLACE_WITH_YOUR_VERIFIED_SENDER_EMAIL
BREVO_SENDER_NAME=BalanceBook

# ── Behaviour ─────────────────────────────────────────────────────────────
SETTLEMENT_EXACT_MAX_SIZE=12
SEED_PASSWORD=Balance@123
LOG_LEVEL=info

