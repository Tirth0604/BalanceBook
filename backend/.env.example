# ---------------------------------------------------------------------------
# BalanceBook API — copy to .env and fill in. Never commit the real .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
TRUST_PROXY=false

# MongoDB — a replica set (docker-compose.yml) enables multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/balancebook?replicaSet=rs0
MONGODB_DB_NAME=balancebook
USE_TRANSACTIONS=true

# Auth — both secrets must be >= 32 characters.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS / client
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Uploads — driver "local" needs no third-party account.
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:5000
MAX_UPLOAD_BYTES=8388608
# UPLOAD_DRIVER=cloudinary also requires:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional — messages are captured to the console/outbox when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BalanceBook <no-reply@balancebook.app>

# Behaviour
SETTLEMENT_EXACT_MAX_SIZE=12
SEED_PASSWORD=Balance@123
LOG_LEVEL=info
